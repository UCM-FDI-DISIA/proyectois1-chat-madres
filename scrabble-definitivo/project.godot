; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrabble_definitivo"
run/main_scene="res://Opciones/Menú principal/pantalla inicial.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/image="uid://4qlnq0ivfrl3"

[autoload]

GameData="*res://scripts/GameData.gd"
Talo="*res://addons/talo/talo_manager.gd"
Stats="*res://Online/stats.gd"
Settings="*res://Escena_opciones/Settings.gd"

[display]

window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/talo/plugin.cfg")

[internationalization]

locale/locale_filter_mode=1
